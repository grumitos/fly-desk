{
  "name": "fly-desk",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Workspace web privado para busqueda y cotizacion aerea orientado a agentes de viajes.",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "demo": "bun src/demo.ts",
    "build": "bun run build:frontend",
    "build:frontend": "bun scripts/build-frontend.ts",
    "start": "bun src/index.ts",
    "auth:hash": "bun scripts/generate-web-password-hash.ts",
    "typecheck": "tsc --noEmit && bun run --filter './frontend' typecheck",
    "lint": "bun run --filter './frontend' lint",
    "test": "NODE_ENV=test bun test --timeout=600000 ./test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "bun-plugin-tailwind": "^0.0.15",
    "playwright": "1.58.2",
    "typescript": "^5.9.2"
  }
}
