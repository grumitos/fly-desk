{
  "name": "fly-desk",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Workspace web privado para busqueda y cotizacion aerea orientado a agentes de viajes.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend"
  ],
  "overrides": {
    "brace-expansion": "5.0.7"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "demo": "bun src/demo.ts",
    "build": "bun run build:frontend",
    "build:frontend": "bun scripts/build-frontend.ts",
    "start": "bun src/index.ts",
    "start:search": "bun src/index.ts",
    "start:redirect": "bun src/redirect-index.ts",
    "airline-icons:extract": "bun scripts/extract-airline-icons.ts",
    "auth:hash": "bun scripts/generate-web-password-hash.ts",
    "typecheck": "tsc --noEmit && bun run --filter './frontend' typecheck",
    "lint": "bun run --filter './frontend' lint",
    "test": "bun run test:core && bun run test:ui",
    "test:unit": "bun test --timeout=600000 unit.test.ts",
    "test:integration": "bun test --timeout=600000 integration.test.ts",
    "test:core": "bun test --timeout=600000 unit.test.ts integration.test.ts",
    "test:ui": "bun run build:frontend && bun scripts/run-ui-tests.ts",
    "test:coverage": "bun test --timeout=600000 --coverage unit.test.ts integration.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-plugin-tailwind": "^0.1.2",
    "playwright": "1.61.1",
    "typescript": "^6.0.3"
  }
}
