# Basic local defaults
# HOST=127.0.0.1
# FLY_DESK_API_TOKEN=<set when exposing HOST beyond loopback>
# FLY_DESK_WEB_AUTH=0
# FLY_DESK_WEB_PASSWORD_HASH=<scrypt hash from bun scripts/generate-web-password-hash.ts>
# FLY_DESK_WEB_SESSION_SECRET=<at least 32 random chars>
# FLY_DESK_WEB_SESSION_TTL_SECONDS=43200
# FLY_DESK_TRUST_LOOPBACK_CLIENT=0
# FLY_DESK_TRUST_REVERSE_PROXY_LOOPBACK=0
# FLY_DESK_COOKIE_SECURE=1
# SEARCH_MAX_FUTURE_DAYS=365
# SEARCH_REVALIDATION_CACHE_TTL_MS=14400000
# SEARCH_COMPLETED_SESSION_TTL_MS=14400000
# SEARCH_COMPLETED_SESSION_RESIDENT_BUDGET_BYTES=134217728
# Completed jobs above this combined serialized budget become SQLite-only after a short grace;
# running jobs are never evicted and /r/<id> remains available until the session TTL.
# SEARCH_PERSISTED_RESTORE_BUDGET_BYTES=16777216
# How much of that cache is parsed back into memory at boot, before the port opens. It is a
# pre-warm: whatever is not restored stays on disk and is read on demand. Raise it only with a
# boot timing to justify it — the search runner's journal reports one whenever the boot is slow.
# FLY_DESK_QUOTATION_RATE_TIMEOUT_MS=1500
# FLY_DESK_SEARCH_WORKER_PROCESSES=1
# One long-lived worker per provider, multiplexing searches and warmed by the
# prewarm loop; 0 spawns a cold worker per provider per search instead.
# FLY_DESK_SEARCH_WORKER_POOL=1
# FLY_DESK_SEARCH_WORKER_MAX_JOBS=500
# Keep provider searches isolated in workers in production. Use 0 only as a temporary QA exception,
# and repeat external QA before changing worker process counts or warm-up behavior.
# FLY_DESK_SEARCH_CAPACITY_UNITS=4
# FLY_DESK_SEARCH_EXACT_COST_UNITS=1
# FLY_DESK_SEARCH_RANGE_COST_UNITS=2
# FLY_DESK_SEARCH_MATRIX_COST_UNITS=2
# FLY_DESK_SEARCH_MAX_QUEUED=8
# FLY_DESK_SEARCH_QUEUE_TIMEOUT_MS=120000
# Search admission uses units: exact searches cost 1; range and matrix searches cost 2.
# The default budget admits two heavy searches at once, queues extra work, and releases
# capacity only after provider work has completed or been cancelled.
# FLY_DESK_DISABLE_BACKGROUND_SEARCH_JOBS=1
# FLY_DESK_BACKGROUND_SEARCH_START_DELAY_MS=0
# FLY_DESK_CACHED_BACKGROUND_SEARCH_START_DELAY_MS=250
# FLY_DESK_PROVIDER_PREWARM=1
# FLY_DESK_PROVIDER_PREWARM_INTERVAL_MS=600000
# FLY_DESK_APP_DATA_DIR=/var/lib/fly-desk
# When FLY_DESK_APP_DATA_DIR is set, SQLite caches default to that directory
# instead of the release-local output/cache path.
# FLY_DESK_SESSION_DB_PATH=<optional explicit session SQLite path>
# FLY_DESK_LOCATION_SUGGESTION_DB_PATH=<optional explicit autocomplete SQLite path>
# FLY_DESK_LOCATION_USAGE_DB_PATH=<optional explicit global ranking SQLite path>
# FLY_DESK_QUOTATION_RATE_URL=https://free.e-api.net.pe/tipo-cambio/today.json
# FLY_DESK_QUOTATION_RATE_CACHE_PATH=<defaults to private app data, not /tmp>
# Where marks fetched for carriers the release does not bundle are kept.
# Defaults to the app data directory; they are a cache and can be deleted.
# FLY_DESK_AIRLINE_MARK_DIR=<defaults to private app data>
# FLY_DESK_PERF_LOG=0
# FLY_DESK_PERF_LOG_SLOW_MS=1000
# Bun closes quiet in-flight requests after 10s by default; Click and Book Plus redirects
# may need longer while validating or refreshing tokens.
# FLY_DESK_SERVER_IDLE_TIMEOUT_SECONDS=120
# Dedicated redirect resolver for /r/<id>. In production this is a separate
# loopback-only Bun process that reads the shared session SQLite cache.
# FLY_DESK_REDIRECT_HOST=127.0.0.1
# FLY_DESK_REDIRECT_PORT=8102
# FLY_DESK_REDIRECT_CACHE_LOOKUP_TIMEOUT_MS=1000

# Agil session extraction prefers origin-scoped Chrome/CDP reads.
# Raw Chrome storage file scanning is disabled by default because file contents
# do not prove Chrome origin ownership; enable only for controlled recovery.
# Live Agil HTTP requests also require:
# AGIL_APIM_SUBSCRIPTION_KEY=<subscription key>
# On Linux/VPS, Fly Desk defaults to the platform Chrome CDP endpoint at
# http://127.0.0.1:9222 when neither browser override is set. Windows keeps
# discovery explicit. Both overrides remain origin-scoped:
# AGIL_BROWSER_URL=http://127.0.0.1:9222
# AGIL_BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/<id>
# AGIL_BROWSER_CONNECT_TIMEOUT_MS=2500
# CHROME_USER_DATA_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# AGIL_CHROME_PROFILE=Default
# AGIL_CHROME_USER_DATA_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# AGIL_CHROME_PROCESS_DISCOVERY=0
# AGIL_SCAN_ALL_CHROME_PROFILES=0
# AGIL_RAW_CHROME_STORAGE_FILE_SCAN=0
# AGIL_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# AGIL_TEMP_CHROME_STORAGE_FALLBACK=0
# AGILSMART_HOST_IP=1.2.3.4
# AGIL_HTTP_TIMEOUT_MS=20000
# AGIL_SESSION_REVALIDATE_MS=60000
# Shared concurrency caps to avoid saturating the local machine.
# Provider-specific values can lower these, but not exceed them.
# 7 lets an Agil exact search hit all seven GDS ids in one wave. This value is
# also a floor; to go back to the previous two-wave fan-out set the provider
# value AGIL_GDS_SEARCH_CONCURRENCY=4 instead.
SEARCH_PROVIDER_SUBREQUEST_CONCURRENCY=7
SEARCH_MATRIX_CELL_CONCURRENCY=6
SEARCH_RANGE_SEARCH_CONCURRENCY=4
# Migratory search scans every selected month; this controls how many months run at once.
FLY_DESK_MIGRATION_CONCURRENT_MONTHS=4

AGIL_GDS_SEARCH_CONCURRENCY=7
# Process-wide ceiling on Agil /mv/search requests in flight; never below 7.
# AGIL_MAX_INFLIGHT_SEARCH_REQUESTS=32
AGIL_MATRIX_CELL_CONCURRENCY=6
AGIL_RANGE_SEARCH_CONCURRENCY=4
# AGIL_RANGE_DAY_RETRY_ATTEMPTS=1
# AGIL_RANGE_DAY_RETRY_DELAY_MS=250

# Click and Book Plus provider defaults. The internal provider id remains
# "costamar" for cache/session compatibility.
# If CBPLUS_TOKEN is omitted, Fly Desk will try to recover the freshest
# branded JWT automatically from the Chrome profile session files.
# CBPLUS_SEARCH_API_BASE_URL=https://air-search-service-zneith.zdev.tech/v2
# CBPLUS_BRAND_BASE_URL=https://flights.zdev.tech/vuelos/pro
# CBPLUS_ENGINE_API_BASE_URL=https://api-zneith.zdev.tech/api-engine
# CBPLUS_MARKUP_API_BASE_URL=https://commons-service-b-zneith.zdev.tech/markup-service
# CBPLUS_AIR_API_BASE_URL=https://api-zneith.zdev.tech/api-air-0.1
# CBPLUS_LANG=es
# CBPLUS_TERMINAL_ID=<terminal-id>
# CBPLUS_TOKEN=<jwt token>
# CBPLUS_CHROME_PROFILE=Profile 40
# CBPLUS_CHROME_USER_DATA_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# CBPLUS_AGENT_CHROME_USER_DATA_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# CBPLUS_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# CBPLUS_REDIRECT_VERIFY_TIMEOUT_MS=6000
# The B2B login URL must remain HTTPS on the exact b2b.clickandbook.com origin;
# HTTP and every other origin fail closed before credentials or OTP are used.
# CBPLUS_B2B_BASE_URL=https://b2b.clickandbook.com/lang/es/b2b
# CBPLUS_B2B_EMAIL=agent@example.com
# CBPLUS_B2B_USERNAME=agent@example.com
# CBPLUS_B2B_PASSWORD=<password-from-secret-manager>
# CBPLUS_B2B_TOTP_SECRET=<base32-totp-secret>
# CBPLUS_B2B_TOTP_URI=otpauth://totp/...
# CBPLUS_B2B_TOTP_MIN_REMAINING_SECONDS=5
# Also accepts otpauth://..., otpauth-migration://..., and JSON with totpUri.
# CBPLUS_B2B_AUTOMATION_ENABLED=1
# CBPLUS_B2B_PROMPT_ENABLED=1
# CBPLUS_B2B_AUTOMATION_ALLOW_SESSION_ONLY=1
# CBPLUS_B2B_USE_LIVE_BROWSER=0
# CBPLUS_B2B_CLONE_CHROME_PROFILE=0
# CBPLUS_B2B_PLAYWRIGHT_FALLBACK_ENABLED=0
# CBPLUS_B2B_DEBUG=0
# CBPLUS_CDP_TAB_SCAN_ENABLED=0
# CBPLUS_BROWSER_HEADLESS=1
# CBPLUS_SESSION_WARMUP_ENABLED=1
# CBPLUS_PROVIDER_B2B_PREWARM_ENABLED=0
# CBPLUS_SESSION_WARMUP_OPEN_BROWSER_FALLBACK=1
# CBPLUS_SESSION_WARMUP_TIMEOUT_MS=8000
# CBPLUS_SESSION_WARMUP_COOLDOWN_MS=30000
# CBPLUS_REDIRECT_TOTAL_TIMEOUT_MS=55000
# Emit the branded redirect directly when the resolved token is still valid for the
# configured terminal, instead of re-running a live provider search first. Set to 0 to
# always revalidate upstream, which fails closed if the provider is unreachable.
# CBPLUS_REDIRECT_TRUST_USABLE_TOKEN=1
# CBPLUS_HTTP_TIMEOUT_MS=20000
# CBPLUS_MATRIX_CELL_CONCURRENCY=6
# CBPLUS_RANGE_SEARCH_CONCURRENCY=4
# CBPLUS_RANGE_DAY_RETRY_ATTEMPTS=1
# CBPLUS_RANGE_DAY_RETRY_DELAY_MS=250
# CBPLUS_PREWARM_ORIGIN=<IATA_ORIGIN>
# CBPLUS_PREWARM_DESTINATION=<IATA_DESTINATION>
# Legacy fallback names still accepted for token/session migration:
# COSTAMAR_TERMINAL_ID=<terminal-id>
# COSTAMAR_TOKEN=<jwt token>
# COSTAMAR_MATRIX_CELL_CONCURRENCY=6
# COSTAMAR_RANGE_SEARCH_CONCURRENCY=4
# COSTAMAR_B2B_EMAIL=agent@example.com
# COSTAMAR_B2B_PASSWORD=<password-from-secret-manager>
# COSTAMAR_B2B_TOTP_SECRET=<base32-totp-secret>
# COSTAMAR_B2B_TOTP_URI=otpauth://totp/...
