# Basic local defaults
# HOST=127.0.0.1
# SEARCH_MAX_FUTURE_DAYS=365

# Agil session is extracted from the local Chrome browser automatically.
# Live Agil HTTP requests also require:
# AGIL_APIM_SUBSCRIPTION_KEY=<subscription key>
# AGIL_BROWSER_URL=http://127.0.0.1:9222
# AGIL_BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/<id>
# AGIL_CHROME_PROFILE=Profile 40
# AGILSMART_HOST_IP=1.2.3.4
# AGIL_HTTP_TIMEOUT_MS=20000
# Shared concurrency caps to avoid saturating the local machine.
# Provider-specific values can lower these, but not exceed them.
SEARCH_PROVIDER_SUBREQUEST_CONCURRENCY=4
SEARCH_MATRIX_CELL_CONCURRENCY=6
SEARCH_RANGE_SEARCH_CONCURRENCY=4

AGIL_GDS_SEARCH_CONCURRENCY=4
AGIL_MATRIX_CELL_CONCURRENCY=6
AGIL_RANGE_SEARCH_CONCURRENCY=4

# Costamar provider defaults
# If COSTAMAR_TOKEN is omitted, Fly Desk will try to recover the freshest
# branded JWT automatically from the Chrome profile session files.
# COSTAMAR_API_BASE_URL=https://costamar.com.pe/vuelos/api
# COSTAMAR_BRAND_BASE_URL=https://booking.clickandbook.com/vuelos
# COSTAMAR_LANG=es
# COSTAMAR_TERMINAL_ID=0721808110
# COSTAMAR_TOKEN=<jwt token>
# COSTAMAR_CHROME_PROFILE=Profile 40
# COSTAMAR_CHROME_USER_DATA_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# COSTAMAR_B2B_EMAIL=agent@example.com
# COSTAMAR_B2B_PASSWORD=super-secret
# COSTAMAR_B2B_AUTOMATION_ALLOW_SESSION_ONLY=1
# COSTAMAR_B2B_USE_LIVE_BROWSER=0
# COSTAMAR_CDP_TAB_SCAN_ENABLED=0
# COSTAMAR_BROWSER_HEADLESS=1
# COSTAMAR_SESSION_WARMUP_ENABLED=1
# COSTAMAR_SESSION_WARMUP_OPEN_BROWSER_FALLBACK=1
# COSTAMAR_SESSION_WARMUP_TIMEOUT_MS=8000
# COSTAMAR_HTTP_TIMEOUT_MS=20000
# COSTAMAR_MATRIX_CELL_CONCURRENCY=6
# COSTAMAR_RANGE_SEARCH_CONCURRENCY=4
# COSTAMAR_MARKUP_CONCURRENCY=4
